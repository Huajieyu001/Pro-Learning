<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.huajieyu001.mapper.DeviceFaultRecordsMapper">

    <select id="selectByStartTime2EndTime" resultType="top.huajieyu001.entity.DeviceFaultRecords">
        select * from device_fault_records where occur_time >= #{startTime} and #{endTime} >= occur_time order by device_id;
    </select>
</mapper>
